# Copy to .env.local and fill in what you need.
# Local tip: without RESEND_API_KEY, the contact form still "succeeds" and logs the message to the server console.

# 1) Create a free account at https://resend.com
# 2) API Keys → Create API Key → paste below
RESEND_API_KEY=re_xxxxxxxx

# Where contact-form messages are delivered (your inbox).
CONTACT_TO_EMAIL=siddhantsharma909@gmail.com

# Sender address. Rules:
# - Without a verified domain, use: Portfolio <onboarding@resend.dev>
#   (Resend will only deliver to the email that owns the Resend account.)
# - With a verified domain (recommended for production): Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:4321
